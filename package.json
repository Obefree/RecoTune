{
  "name": "recotune",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node tools/dev-all.mjs && expo start",
    "start:expo": "expo start",
    "dev:all": "node tools/dev-all.mjs",
    "start:offline": "expo start --offline -c --port 8088",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ingest-metadata": "node tools/ingest-musicbrainz-metadata.mjs --target=5000 --limit-artists=80 --max-pages=12",
    "build-catalog": "node tools/build-offline-catalog.mjs",
    "verify-offline-catalog": "node tools/verify-offline-catalog.mjs",
    "ingest-pesni-chords": "node tools/ingest-pesni-chordpro.mjs --target=5000 --per-artist=25 --resume --from-start",
    "ingest-pesni-chords:fresh": "node tools/ingest-pesni-chordpro.mjs --target=5000 --per-artist=25",
    "chord-db:ingest-amdm": "node tools/chord-fetch/ingest-parsed-from-catalog.mjs --resume",
    "chord-db:ingest-ug": "node tools/chord-fetch/ingest-parsed-from-catalog.mjs --source=ug --resume",
    "append-metadata": "node tools/append-metadata-artists.mjs",
    "verify-metadata-search": "node tools/verify-metadata-search.mjs",
    "verify-chord-normalize": "node tools/verify-chord-normalize.mjs",
    "verify-unparsed-chords": "node tools/scan-unparsed-chords.mjs",
    "verify-chord-layout": "node tools/chord-fetch/verify-chord-layout.mjs",
    "verify-chord-transpose": "node tools/verify-chord-transpose.mjs",
    "verify-song-content": "node tools/verify-song-content.mjs",
    "verify-song-library-dedupe": "node tools/verify-song-library-dedupe.mjs",
    "verify-pitch-chart": "node tools/verify-pitch-chart-history.mjs",
    "verify-melody-transcription": "node tools/verify-melody-transcription.mjs",
    "verify-melody-playback": "node tools/verify-melody-playback.mjs",
    "verify-metronome": "node tools/verify-metronome.mjs",
    "verify-tuner-display": "node tools/verify-tuner-display.mjs",
    "verify-tuner-chart": "node tools/verify-tuner-chart-window.mjs",
    "dev-proxy": "npm run dev-proxy --prefix tools/chord-fetch",
    "dev-stack": "npm run dev-stack --prefix tools/chord-fetch",
    "chords:dev": "node tools/chord-fetch/chords-dev.mjs",
    "chord-db:publish": "node tools/chord-fetch/publish-parsed-store.mjs",
    "test-chord-fetch": "node tools/chord-fetch/test-endpoint.mjs",
    "stems:dev": "node tools/stem-separate/stems-dev.mjs",
    "test-stem-separate": "node tools/stem-separate/test-endpoint.mjs",
    "test-stem-transcribe": "node tools/stem-separate/test-endpoint.mjs --transcribe",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --platform android --clean",
    "build:android:release": "build-apk-release.bat",
    "build:android:debug": "build-apk.bat",
    "postinstall": "npx patch-package",
    "start:tunnel": "EXPO_NO_TELEMETRY=1 npx expo start --tunnel --port 8082",
    "expo:url": "node scripts/print-expo-go-url.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "cheerio": "^1.0.0",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "hoist-non-react-statics": "3.3.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-music-control": "^1.4.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "expo-build-properties": "~57.0.17",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "hoist-non-react-statics": "3.3.2",
    "react-native-worklets": "0.10.1"
  },
  "private": true
}
